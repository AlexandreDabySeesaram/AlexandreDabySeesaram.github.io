<figure class="figure">
<p><video src="../../../Resources/Videos/NeuROM_3D_gravity_ter.mov" class="img-fluid quarto-figure quarto-figure-center" style="width:75.0%" loop="true" autoplay="true" controls=""><a href="../../../Resources/Videos/NeuROM_3D_gravity_ter.mov">Video</a></video></p>
</figure>
</div>




